{
    "name": "laravelio/laravel.io",
    "description": "The source code for the Laravel.io community portal.",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "8.5.*",
        "algolia/algoliasearch-client-php": "^4.50.0",
        "algolia/scout-extended": "^5.0.0",
        "blade-ui-kit/blade-heroicons": "^2.3",
        "blade-ui-kit/blade-icons": "^1.10.1",
        "codeat3/blade-simple-icons": "^8.0",
        "embed/embed": "^4.5.0",
        "filament/filament": "^5.10.3",
        "flowframe/laravel-trend": "^0.5.0",
        "guzzlehttp/guzzle": "^8.3.0",
        "guzzlehttp/psr7": "^3.2.0",
        "innocenzi/bluesky-notification-channel": "^0.2.0",
        "intervention/image": "^4.4.0",
        "laravel-notification-channels/telegram": "^8.0.0",
        "laravel/ai": "^1.3",
        "laravel/framework": "^13.38.0",
        "laravel/nightwatch": "^1.30.4",
        "laravel/sanctum": "^4.3.3",
        "laravel/scout": "^11.9.0",
        "laravel/socialite": "^5.31.0",
        "laravel/tinker": "^3.0.2",
        "laravel/ui": "^4.4",
        "league/commonmark": "^2.10.4",
        "league/flysystem-aws-s3-v3": "^3.35.3",
        "livewire/flux": "^2.21.0",
        "livewire/livewire": "^4.4.8",
        "ramsey/uuid": "^4.9.4",
        "resend/resend-laravel": "^1.7.0",
        "spatie/laravel-feed": "^4.4",
        "spatie/laravel-ignition": "^2.12.1",
        "spatie/laravel-login-link": "^1.6",
        "spatie/laravel-mailcoach-mailer": "^1.7.0",
        "spatie/laravel-schedule-monitor": "^4.3.1",
        "spatie/laravel-sitemap": "^8.2.0",
        "symfony/http-client": "^8.1.9",
        "symfony/mailgun-mailer": "^8.1.6"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "fruitcake/laravel-debugbar": "^4.4",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^8.9.5",
        "pestphp/pest": "^5.3.3",
        "pestphp/pest-plugin-laravel": "^5.0.1",
        "pestphp/pest-plugin-livewire": "^5.0.0",
        "spatie/pixelmatch-php": "^1.1"
    },
    "autoload": {
        "files": [
            "resources/helpers.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "setup": [
            "php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "php artisan key:generate",
            "php artisan migrate --seed",
            "npm install",
            "npm run build"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
